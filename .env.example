# 3D HUB — Environment Variables
# Copy this file to ".env" and fill in your real credentials.
# Never commit the actual .env file — it contains secrets.

# ── Supabase (database, auth, realtime) ────────────────────────────
# Find these in your Supabase project: Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── Cloudinary (image & file storage, 25 GB free) ──────────────────
# 1. Sign up free at https://cloudinary.com
# 2. Cloud Name is on your dashboard homepage
# 3. Create an upload preset: Settings → Upload → Add upload preset
#    Set Signing Mode = Unsigned, Folder = 3dhub
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset_name

# ── Razorpay (payments) ────────────────────────────────────────────
# Find in Razorpay dashboard: Settings → API Keys
VITE_RAZORPAY_KEY_ID=rzp_test_yourkeyid
# RAZORPAY_KEY_SECRET → server-side ONLY, never put here

# ── Admin bootstrap ────────────────────────────────────────────────
# After signing up, run this SQL in Supabase to grant admin:
#   update public.profiles set role = 'admin' where email = 'your@email.com';
VITE_ADMIN_BOOTSTRAP_EMAIL=admin@3dhub.example
